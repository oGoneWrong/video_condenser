.env
*.wav
*.mp3
__pycache__/
*.pyc

# Local Claude/HyperFrames tooling state, not part of this project's own
# code - a skills cache and its lockfile, plus a stray empty R session
# history file from unrelated work in this same directory.
.agents/
skills-lock.json
.Rhistory

# Exception: runs/ snapshots are frozen history, not regenerable working
# files - their narration .wav clips are deliberately committed so each
# run stays independently inspectable (exact per-slide timing, reusable
# without re-running Kokoro) rather than only audible inside a compiled
# .mp4. Everything else still matches the blanket *.wav rule above.
!runs/**/*.wav

# Generated per-video, not source - anyone cloning the repo regenerates
# these by running the pipeline on their own transcript/insights.
slides/
videos/*.mp4
render/compositions/*.html
render/compositions/*_audio/

# HyperFrames project's own local state/cache, not part of the repo.
render/node_modules/
render/.hyperframes/
render/.thumbnails/
.video_build_tmp/
.DS_Store

# HyperFrames scaffold-generated AI-agent routing docs (generic skill
# instructions, not authored for this project, identical to each other) -
# tooling scaffolding, not this project's own work.
render/CLAUDE.md
render/AGENTS.md

# Ad-hoc HeyGen-voice debugging script from earlier troubleshooting - not
# part of the documented pipeline, and imports from .agents/skills/ (also
# gitignored below), so it wouldn't even run for anyone cloning the repo.
voice_test/

# Generated per-video (Step 1/3 output) - regenerated by re-running the
# pipeline on the same URL, same reasoning as slides/videos/render below.
transcripts/
insights/

# Map-asset generator deps (one-time tool; its output JSON is committed).
tools/taiwan_map/node_modules/

# Generated by tools/heygen_avatar/generate_avatar_clip.py - a per-video,
# metered HeyGen output, not something to check in.
avatar_clips/
